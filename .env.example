# EduMentor AI — mẫu biến môi trường
# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Mọi giá trị dưới đây chỉ là minh họa. Hướng dẫn: SETUP.md §3.

# Ứng dụng
APP_ENV=development
VERSION=1.0.0
# Xác thực (docs/decisions.md D-AUTH-01 … D-AUTH-03)
# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=thay-bang-chuoi-ngau-nhien
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Đề xuất — CHƯA CHỐT (ND-40)
REFRESH_TOKEN_EXPIRE_DAYS=7
# Đề xuất 15–30 phút (.docx 3.4)
RESET_TOKEN_EXPIRE_MINUTES=30
SQL_ECHO=True
# Email — quên mật khẩu, email kết quả ôn tập (T28)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
FRONTEND_URL=http://localhost:5173
ALGORITHM=HS256
# Cơ sở dữ liệu
DATABASE_URL=postgresql+psycopg://edumentor:edumentor123@localhost:5433/edumentor_db

# AI
LLM_API_KEY=your-api-key
LLM_MODEL=ten-model                 # chatbot (Tâm): gemini-3.6-flash
# Ôn tập (Tuấn) dùng model riêng — để trống thì dùng LLM_MODEL / LLM_API_KEY ở trên
REVIEW_LLM_MODEL=gemini-3.5-flash-lite
REVIEW_LLM_API_KEY=
# Hòa — gợi ý lộ trình (LLM chạy cục bộ bằng llama.cpp trong docker-compose; Qdrant lưu vector kỹ năng)
HF_TOKEN=hf_your_actual_token_here
LLM_URL_BASE=http://localhost:8080
LLM_URL_ADAPTER=http://localhost:8081
QDRANT_URL=http://localhost:6335

# Ôn tập — module 09 (chốt 09/11)
# mock = không gọi AI thật, 0 đồng (giai đoạn 1); real = gọi LLM bằng LLM_API_KEY (giai đoạn 2)
AI_MODE=mock
REVIEW_PASS_SCORE=6
REVIEW_GRADING_TIMEOUT=20
REVIEW_GRADING_MAX_WAIT=120
REVIEW_BANK_TARGET_PER_SKILL=20

# Frontend (đặt trong frontend/.env; biến VITE_* lộ ra trình duyệt — không đặt bí mật)
VITE_API_BASE_URL=http://localhost:8000/api
# true = dùng dữ liệu mẫu src/mock/ khi chưa có backend (docs/decisions.md D-FE-07)
VITE_USE_MOCK=false